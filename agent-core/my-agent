#!/usr/bin/env python3
"""Launcher when cwd is agent-core (T-112)."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path

_CLI = Path(__file__).resolve().parent / "cli_tools.py"

if __name__ == "__main__":
    sys.argv[0] = str(_CLI)
    runpy.run_path(str(_CLI), run_name="__main__")
