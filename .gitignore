# 根目录一次性调试脚本 / 临时文件（移入 _trash/ 清理）
/_*
!/_trash/

# 本地状态与运行时（RUNTIME / MAP：data 默认不进 Git）
data/
agent-core/data/

# 敏感工作文件
workspace/
!workspace/
workspace/*
!workspace/test/
workspace/test/*
!workspace/test/*.md
!workspace/test/.plan-agent/
workspace/test/.plan-agent/*
!workspace/test/.plan-agent/manifest.json
!workspace/test/.plan-agent/changes.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 环境密钥与本机私货
.env
.env.*
.money-state.json
.cursor/mcp.json
evolve/user_profile.md

# 本机品牌图（非产品构建必需）
/project-avatar.png
/project-avatar-circle.png

# Node / Electron（desktop/.gitignore 亦有；根级兜底）
node_modules/
dist/
dist-electron/
*.log

# Local 0x567 E2E probe dumps (tools/e2e_0x567_flash.py --report)
/e2e-0x567-*.json
/e2e-flash-smoke-probe*.json
artifacts/

# Desktop e2e run output kept beside the tests (logs, one-off log parsers,
# per-run artifacts); would block sandbox merge. _run*.cmd launchers are tracked.
/desktop/_e2e*
/desktop/_harness-*
/desktop/_parse*
/desktop/_artifacts-*/
/desktop/scripts/_e2e-*
/desktop/@AutomationLog.txt

# OS
Thumbs.db
.DS_Store

# Git worktrees (sandbox evolution); never commit nested checkout
.worktrees/

# Dual-lane local media (not product; would block sandbox merge)
/side-left-canvas.png
/side-left-tight.png
/side-right-canvas.png
/side-right-tight.png
/小魔王回忆录/

# Local scratch / probe trees (never source)
.vp/
.x/
.y/
.z/
storage-*/

# Local sealed/managed Host runtime (never publish)
.managed-runtime/

