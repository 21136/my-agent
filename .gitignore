# 根目录一次性调试脚本 / 临时文件（移入 _trash/ 清理）
/_*
!/_trash/

# 本地状态与运行时（RUNTIME / MAP：data 默认不进 Git）
data/
agent-core/data/

# 敏感工作文件
workspace/
!workspace/
workspace/*
!workspace/test/
workspace/test/*
!workspace/test/*.md
!workspace/test/.plan-agent/
workspace/test/.plan-agent/*
!workspace/test/.plan-agent/manifest.json
!workspace/test/.plan-agent/changes.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 环境密钥与本机私货
.env
.env.*
.money-state.json
.cursor/mcp.json

# Node / Electron（desktop/.gitignore 亦有；根级兜底）
node_modules/
dist/
dist-electron/
*.log

# OS
Thumbs.db
.DS_Store
